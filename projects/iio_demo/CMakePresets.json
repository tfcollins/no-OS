{
    "version": 8,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "comment": "IIO Demo project presets - supports: maxim, stm32, aducm3029, pico, linux, xilinx",

    "configurePresets": [
        {
            "name": "default",
            "description": "Default config",
            "generator": "Unix Makefiles"
        },
        {
            "name": "max78000_fthr",
            "displayName": "MAX78000 Feather (Maxim)",
            "description": "MAX78000 feather board - auto-detects FetchContent vs local no-OS",
            "inherits": "default",
            "cacheVariables": {
                "BOARD": "MAX78000_FTHR",
                "USE_VENDOR_TOOLCHAIN": "OFF",
                "PLATFORM": "maxim",
                "TARGET": "max78000",
                "TARGET_NUM": "78000",
                "BOARD_CONFIG_FILE": "max78000_fthr_defconfig"
            }
        },
        {
            "name": "max32650_fthr",
            "displayName": "MAX32650 Feather (Maxim)",
            "description": "MAX32650 feather board - auto-detects FetchContent vs local no-OS",
            "inherits": "default",
            "cacheVariables": {
                "BOARD": "MAX32650_FTHR",
                "USE_VENDOR_TOOLCHAIN": "ON",
                "PLATFORM": "maxim",
                "TARGET": "max32650",
                "TARGET_NUM": "32650",
                "BOARD_CONFIG_FILE": "max32650_fthr_defconfig"
            }
        },
        {
            "name": "apard32690",
            "displayName": "APARD32690 (Maxim)",
            "description": "APARD32690 board - auto-detects FetchContent vs local no-OS",
            "inherits": "default",
            "cacheVariables": {
                "BOARD": "APARD32690",
                "USE_VENDOR_TOOLCHAIN": "ON",
                "PLATFORM": "maxim",
                "TARGET": "max32690",
                "TARGET_NUM": "32690",
                "BOARD_CONFIG_FILE": "apard32690_defconfig"
            }
        },
        {
            "name": "stm32f756_nucleo",
            "displayName": "STM32F756 Nucleo (STM32)",
            "description": "STM32F756 Nucleo board - auto-detects FetchContent vs local no-OS",
            "inherits": "default",
            "cacheVariables": {
                "BOARD": "sdp-ck1z",
                "USE_VENDOR_TOOLCHAIN": "OFF",
                "PLATFORM": "stm32",
                "TARGET": "stm32f756",
                "TARGET_NUM": "stm32f756",
                "BOARD_CONFIG_FILE": "stm32f756_nucleo_defconfig"
            }
        },
        {
            "name": "ad9081_zcu102",
            "displayName": "AD9081 on ZCU102 (Xilinx Zynq UltraScale+)",
            "description": "AD9081 on Xilinx ZCU102 - auto-detects FetchContent vs local no-OS",
            "inherits": "default",
            "cacheVariables": {
                "BOARD": "ad9081_zcu102",
                "PLATFORM": "xilinx",
                "TARGET": "zynqmp",
                "BOARD_CONFIG_FILE": "ad9081_zcu102_defconfig",
                "XILINX_ARCH": "cortexa53",
                "XILINX_PROC": "psu_cortexa53_0",
                "XPS_BOARD": "ZCU102"
            }
        },
        {
            "name": "ad9361_zcu102",
            "displayName": "AD9361 on ZCU102 (Xilinx Zynq UltraScale+)",
            "description": "AD9361 on Xilinx ZCU102 - auto-detects FetchContent vs local no-OS",
            "inherits": "default",
            "cacheVariables": {
                "BOARD": "ad9361_zcu102",
                "PLATFORM": "xilinx",
                "TARGET": "zynqmp",
                "BOARD_CONFIG_FILE": "ad9361_zcu102_defconfig",
                "XILINX_ARCH": "cortexa53",
                "XILINX_PROC": "psu_cortexa53_0",
                "XPS_BOARD": "ZCU102"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "iio_demo",
            "displayName": "IIO Demo",
            "description": "Build the IIO Demo application",
            "targets": ["iio_demo"]
        }
    ]
