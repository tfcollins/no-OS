# OpenOCD configuration generated by no-OS CMake.
# STAND-IN template for the (uncommitted) cmake/ide/templates/openocd.in.
# Consumed via configure_file(@ONLY) by cmake/project_utils.cmake.

source [find @OPENOCD_INTERFACE@]

@OPENOCD_EXTRA_COMMANDS@

set CHIPNAME @OPENOCD_CHIPNAME@
source [find @OPENOCD_TARGETCFG@]

@OPENOCD_POST_COMMANDS@
